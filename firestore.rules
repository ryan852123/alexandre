rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Administradores: documentos em "admins" (ID = e-mail em minúsculas), criados à mão no Firebase.
    function admin() {
      return request.auth != null && request.auth.token.email_verified == true
        && exists(/databases/$(db)/documents/admins/$(request.auth.token.email));
    }
    function teacher() {
      return request.auth != null && request.auth.token.email_verified == true
        && exists(/databases/$(db)/documents/teachers/$(request.auth.token.email));
    }
    match /admins/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
    }
    match /teachers/{email} {
      allow read: if request.auth != null && (request.auth.token.email == email || admin());
      allow write: if admin();
    }
    match /students/{uid} {
      allow read: if admin() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.status == 'pendente';
      allow update, delete: if admin();
    }
    match /enrollments/{id} {
      allow read: if admin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow write: if admin();
    }
    match /payments/{id} {
      allow read: if admin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow write: if admin();
    }
    match /classes/{id} {
      allow read: if admin() || (request.auth != null
        && (request.auth.uid in resource.data.alunoIds || resource.data.profEmail == request.auth.token.email));
      allow create, delete: if admin();
      allow update: if admin() || (teacher() && resource.data.profEmail == request.auth.token.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['materiais']));
    }
    match /attendance/{id} {
      allow read: if admin() || (request.auth != null
        && (resource.data.profEmail == request.auth.token.email || request.auth.uid in resource.data.alunoIds));
      allow create, update: if admin() || (teacher()
        && request.resource.data.profEmail == request.auth.token.email
        && get(/databases/$(db)/documents/classes/$(request.resource.data.classId)).data.profEmail == request.auth.token.email);
      allow delete: if admin();
    }
  }
}
